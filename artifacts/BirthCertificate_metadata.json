		"devdoc": {
			"details": "Educational project contract — minimal on purpose. No proxy pattern,      no multi-sig, no upgradeability. This is intentional for course scope.",
			"kind": "dev",
			"methods": {
				"issueCertificate(string,bytes32)": {
					"details": "Automatic issuance — no admin approval step, per project scope.",
					"params": {
						"certHash": "SHA-256 hash of the generated PDF (computed by backend)",
						"certId": "Unique certificate identifier generated off-chain (e.g. UUID)"
					}
				},
				"payVerificationFee(string)": {
					"details": "Kept separate from getCertificate() so that reading is free (view),      while the *act* of requesting a paid verification is recorded on-chain."
				}
			},
			"title": "BirthCertificate",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"getCertificate(string)": {
					"notice": "Read a certificate's stored data. Free — no gas cost beyond the read itself."
				},
				"issueCertificate(string,bytes32)": {
					"notice": "Issue a new certificate record by paying the issuance fee."
				},
				"payVerificationFee(string)": {
					"notice": "Pay the verification fee. Emits an event; actual hash comparison         happens off-chain in the backend using getCertificate()."
				}
			},
			"notice": "Stores hashes of issued birth certificates on-chain and lets         anyone verify a certificate's integrity by comparing hashes.",
			"version": 1
		}
